# Caddy gets and renews a Let's Encrypt certificate for each name on its own, once the
# GoDaddy A records point both names at the instance's static IP (RAA-156).

# HSTS (RAA-222): browsers remember it for max-age seconds, so it starts at 5 minutes and is
# raised (1 day, then a year with includeSubDomains) once staging is seen working over it.
# The API host gets HSTS from Rails' force_ssl. -Server drops Caddy's name.
staging.tripkonext.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=300"
		-Server
	}
	reverse_proxy web:3000
}

# /cable is the WebSocket server (anycable, RAA-202); reverse_proxy passes the upgrade as is.
# /_anycable is where anycable asks Rails to approve a connection, inside Compose only.
# No access log.
api.staging.tripkonext.com {
	encode zstd gzip
	handle /cable {
		reverse_proxy anycable:8080
	}
	handle /_anycable* {
		respond 404
	}
	handle {
		reverse_proxy backend:3000
	}
}
