# Caddy gets and renews a Let's Encrypt certificate for each name on its own, once the
# GoDaddy A records point both names at the instance's static IP (RAA-156).

staging.tripkonext.com {
	encode zstd gzip
	reverse_proxy web:3000
}

# /cable is the WebSocket server (anycable, RAA-202); reverse_proxy passes the upgrade as is.
# /_anycable is where anycable asks Rails to approve a connection, inside Compose only.
# No access log: the WebSocket URL carries the access token (?token=).
api.staging.tripkonext.com {
	encode zstd gzip
	handle /cable {
		reverse_proxy anycable:8080
	}
	handle /_anycable* {
		respond 404
	}
	handle {
		reverse_proxy backend:3000
	}
}
