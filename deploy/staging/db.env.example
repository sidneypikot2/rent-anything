# The staging Postgres passwords: copy to /opt/tripkonext/db.env on the instance (chmod 600)
# and fill in. Letters and digits only, so they need no escaping in backend.env's URLs; a new
# one each:
#   openssl rand -hex 24
#
# The superuser (RAA-174), for the db container, psql and the nightly dump. Neither the API nor
# its migrations connect as it any more (RAA-217).
# Postgres reads it only when the volume is first created; changing it later means
# ALTER USER postgres PASSWORD '...' in psql as well.
POSTGRES_PASSWORD=

# The two roles db-roles.sh creates (RAA-217); it reads them from this file. backend.env's
# MIGRATION_* URLs use the owner's, its runtime URLs the app's. Changing one means editing it
# here and in backend.env, running ./db-roles.sh again, then docker compose up -d backend.
RENT_ANYTHING_OWNER_PASSWORD=
RENT_ANYTHING_APP_PASSWORD=
