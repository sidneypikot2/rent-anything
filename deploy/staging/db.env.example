# The staging Postgres container's password (RAA-174): copy to /opt/tripkonext/db.env on the
# instance (chmod 600) and fill in. backend.env's three database URLs use the same value.
# Letters and digits only, so it needs no escaping in those URLs:
#   openssl rand -hex 24
# Postgres reads it only when the volume is first created; changing it later means
# ALTER USER postgres PASSWORD '...' in psql as well.
POSTGRES_PASSWORD=
