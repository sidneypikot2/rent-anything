# The API's secrets on the staging instance (RAA-156): copy to /opt/tripkonext/backend.env
# there (chmod 600) and fill in. Never commit the filled-in file. Non-secret settings
# (RAILS_ENV, SOLID_QUEUE_IN_PUMA, RAILS_MAX_THREADS, BOOKINGS_AUTO_ACCEPT) are in compose.yml.
# A new backend variable goes here and in backend/.env.example, and is set on the instance
# before the PR that needs it merges into staging.

RAILS_MASTER_KEY=

# Neon, direct (not -pooler) connection strings: PgBouncer's transaction mode breaks the
# advisory locks migrations take. The primary uses the postgis:// scheme.
DATABASE_URL=
CACHE_DATABASE_URL=
QUEUE_DATABASE_URL=

# Upstash, rediss:// (TLS).
REDIS_URL=

# Exactly the web URL, no trailing slash: CORS allows this origin only.
FRONTEND_ORIGIN=https://staging.tripkonext.com

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Didit sandbox application (RAA-44); its webhook destination is
# https://api.staging.tripkonext.com/api/v1/webhooks/didit
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Listing photos on Cloudflare R2 (RAA-106): the public URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Active Record Encryption (RAA-145): the same values Render had. Changing them makes the
# saved payout account numbers unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
