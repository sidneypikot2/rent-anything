# The API's secrets on the staging instance (RAA-156): copy to /opt/tripkonext/backend.env
# there (chmod 600) and fill in. Never commit the filled-in file. Non-secret settings
# (RAILS_ENV, SOLID_QUEUE_IN_PUMA, RAILS_MAX_THREADS, BOOKINGS_AUTO_ACCEPT, REDIS_URL) are in compose.yml.
# A new backend variable goes here and in backend/.env.example, and is set on the instance
# before the PR that needs it merges into staging.

RAILS_MASTER_KEY=

# The db service in compose.yml (RAA-174). <password> is POSTGRES_PASSWORD from db.env.
# The primary uses the postgis:// scheme. db:prepare creates all three databases on boot.
DATABASE_URL=postgis://postgres:<password>@db:5432/rent_anything_staging
CACHE_DATABASE_URL=postgres://postgres:<password>@db:5432/rent_anything_staging_cache
QUEUE_DATABASE_URL=postgres://postgres:<password>@db:5432/rent_anything_staging_queue

# Exactly the web URL, no trailing slash: CORS allows this origin only (a comma-separated
# list allows several; email links use the first). Required: without it the API won't boot.
FRONTEND_ORIGIN=https://staging.tripkonext.com

# The hostnames the API answers to (RAA-218, config.hosts in production.rb); any other Host
# header gets a 403. Required: without it the API won't boot. The public API host, plus
# "backend", the name the web's server-side rendering (API_INTERNAL_URL) and AnyCable's RPC
# (ANYCABLE_RPC_HOST, /_anycable) call it by inside Compose. A name matches with any port.
API_HOSTS=api.staging.tripkonext.com,backend

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Didit sandbox application (RAA-44); its webhook destination is
# https://api.staging.tripkonext.com/api/v1/webhooks/didit
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# PayMongo, test mode only (sk_test_...; a live key is refused). Its webhook endpoint is
# https://api.staging.tripkonext.com/api/v1/webhooks/paymongo (checkout_session.payment.paid).
# Blank, payments stay a stub that confirms at once.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Email through Gmail (tripkonext@gmail.com); SMTP_PASSWORD is a Gmail App Password.
# Production will use GoDaddy instead: smtpout.secureserver.net, 465, team@tripkonext.com.
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tripkonext@gmail.com
SMTP_PASSWORD=
MAILER_FROM=TripKoNext <tripkonext@gmail.com>

# Listing photos on Cloudflare R2 (RAA-106): the public URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Active Record Encryption (RAA-145): the same values Render had. Changing them makes the
# saved payout account numbers unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Sentry, "backend" project in the tripkonext org. Errors show under the staging environment
# (Rails.env); SENTRY_RELEASE, the deployed commit, is set in compose.yml.
SENTRY_DSN=
