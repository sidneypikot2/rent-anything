# The WebSocket server's secret on the staging instance (RAA-202): copy to
# /opt/tripkonext/anycable.env there (chmod 600) and set it with `openssl rand -hex 32`.
# Both the backend and the anycable service read this file; after changing the value run
# `docker compose up -d backend anycable`. Never commit the filled-in file.

ANYCABLE_SECRET=
