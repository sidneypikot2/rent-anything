#!/usr/bin/env bash
# The definition of done, in one command: runs every check CI runs for an area and
# reports which ones failed.
#
#   script/check              everything
#   script/check frontend     eslint, types, production build, API contract
#   script/check backend      rubocop, full rspec suite, API contract
#   script/check tooling      shellcheck, guard and git-hook tests, instruction files, secret scan
#
# Needs Docker and jq. CI runs the same scripts; the security scans (brakeman,
# bundler-audit) stay CI-only. script/smoke is separate: it drives the running app.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
# shellcheck source=script/lib.sh
source script/lib.sh

area="${1:-all}"
case "$area" in
  all|frontend|backend|tooling) ;;
  *) echo "usage: script/check [frontend|backend|tooling]" >&2; exit 2 ;;
esac

failed=()
step() { # name, command...
  local name="$1"; shift
  echo "== $name"
  "$@" || failed+=("$name")
}

if [[ "$area" == all || "$area" == frontend ]]; then
  step "eslint" script/lint frontend
  step "types" web_do npm run --silent typecheck
  step "build" web_do npx next build
fi
if [[ "$area" != tooling ]]; then
  step "API contract" script/check-api
fi
if [[ "$area" == all || "$area" == backend ]]; then
  step "rubocop" script/lint backend
  step "rspec" script/test
fi
if [[ "$area" == all || "$area" == tooling ]]; then
  step "shell lint" script/lint-shell
  step "guards and git hooks" script/test-hooks
  step "instruction files" script/check-docs
  step "secret scan" script/scan-secrets
fi

if (( ${#failed[@]} > 0 )); then
  echo "check: FAILED — ${failed[*]}" >&2
  exit 1
fi
echo "check: ok ($area)"
