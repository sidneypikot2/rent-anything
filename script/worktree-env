#!/usr/bin/env bash
# Gives a git worktree its own Docker Compose stack: picks a free port offset N and
# writes <worktree>/.env (which Compose reads automatically) so that
#   web = 8100+N, backend = 3100+N, db = 5532+N, redis = 6479+N
# and the project name is unique, so containers and volumes don't mix with the main
# checkout's. Idempotent: an existing .env is kept and its ports printed again.
#
# It also copies the main checkout's gitignored env files (backend/.env, web/.env.local:
# OAuth ids, API keys) into a worktree that has none, so its stack boots with the same
# keys (RAA-96). A worktree's own copy is never overwritten, and only file names are printed.
#
#   script/worktree-env          # then: docker compose up -d
#
# Refuses to run in the main checkout, which always uses the default ports.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
if [[ "$(git rev-parse --path-format=absolute --git-dir)" == "$(git rev-parse --path-format=absolute --git-common-dir)" ]]; then
  echo "worktree-env: this is the main checkout — it uses the default ports (8100 / 3100)." >&2
  exit 1
fi

env_file="$root/.env"

in_use() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

# Frontend ports other worktrees have already claimed in their .env, running or not.
claimed="$(git worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r wt; do
  [[ -f "$wt/.env" ]] && sed -n 's/^FRONTEND_PORT=//p' "$wt/.env"
done || true)"
is_claimed() { grep -qx "$1" <<<"$claimed"; }

if [[ ! -f "$env_file" ]]; then
  offset=""
  for n in $(seq 1 30); do
    if ! is_claimed $((8100 + n)) && ! in_use $((8100 + n)) && ! in_use $((3100 + n)) && ! in_use $((5532 + n)) && ! in_use $((6479 + n)); then
      offset="$n"; break
    fi
  done
  [[ -n "$offset" ]] || { echo "worktree-env: no free port offset in 1..30" >&2; exit 1; }

  name="$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/-*$//')"
  cat > "$env_file" <<EOF
# Written by script/worktree-env — ports for this worktree's Compose stack.
COMPOSE_PROJECT_NAME=raa-$name
FRONTEND_PORT=$((8100 + offset))
BACKEND_PORT=$((3100 + offset))
DB_PORT=$((5532 + offset))
REDIS_PORT=$((6479 + offset))
EOF
fi

# The main checkout is the first entry `git worktree list` prints. A copy, not a symlink, so
# nothing done in a worktree can change the main checkout's keys.
main_root="$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -n1)"
copied=""
for file in backend/.env web/.env.local; do
  if [[ -f "$main_root/$file" && ! -e "$root/$file" ]]; then
    cp -p "$main_root/$file" "$root/$file"
    copied="$copied $file"
  fi
done

# Print without sourcing, so nothing else in the file is evaluated.
get() { sed -n "s/^$1=//p" "$env_file" | head -n1; }
echo "project:  $(get COMPOSE_PROJECT_NAME)"
echo "web:      http://localhost:$(get FRONTEND_PORT)"
echo "backend:  http://localhost:$(get BACKEND_PORT)"
echo "db:       localhost:$(get DB_PORT)   redis: localhost:$(get REDIS_PORT)"

if [[ -n "$copied" ]]; then
  # On stderr, so it still shows when a script runs this quietly (ensure_worktree_env).
  echo "env:     $copied (copied from the main checkout)" >&2
  if [[ -n "$(docker compose --project-directory "$root" ps -q --status running 2>/dev/null)" ]]; then
    echo "env:      the stack is already up — load them with: docker compose up -d --force-recreate backend web" >&2
  fi
fi
