#!/usr/bin/env bash
# Keeps the instruction files honest. CLAUDE.md, the rules, the skills and the agents
# describe the repository; nothing else notices when the repository moves on. Fails when:
#   1. a path or script they name no longer exists;
#   2. a rule's `paths:` pattern matches no file (such a rule never loads);
#   3. CLAUDE.md outgrows 100 lines (it loads into every session);
#   4. SPEC.md still describes as "not built" a route that config/routes.rb now has.
# and keeps the Claude Code config wired up. Claude Code skips what it can't read without
# saying so, so these fail when:
#   5. .claude/settings.json or .mcp.json isn't valid JSON;
#   6. a hook names an unknown event or a script that doesn't exist or isn't executable,
#      a .claude/hooks/ script isn't wired to any event, or an allow rule names a missing script;
#   7. an agent lacks a name or description, or its name isn't the kebab-case file name;
#   8. a skill lacks a description, or its name isn't the kebab-case directory name.
# Plain bash, git and jq. Run from anywhere; exits 1 and lists every problem. Used by CI.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
errors=0
fail() { echo "check-docs: $1" >&2; errors=$((errors + 1)); }

docs=(CLAUDE.md .claude/rules/*.md .claude/skills/*/SKILL.md .claude/agents/*.md)

# 1. Paths in `backticks`. Only text that is clearly a path in this repository counts:
#    it has a slash, no spaces or placeholders, and isn't a route, a URL, a git ref or a
#    home-directory path. The files write paths relative to backend/, web/ or
#    .claude/, so those are tried too. Gitignored paths (backend/.env, node_modules) can't be checked.
exists() {
  local p="${1%/}" base
  for base in "" backend/ web/ .claude/; do
    [[ -e "$base$p" ]] && return 0
  done
  # (--quiet takes one path at a time.)
  git check-ignore -q -- "$p" 2>/dev/null || git check-ignore -q -- "backend/$p" 2>/dev/null
}
for doc in "${docs[@]}"; do
  [[ -f "$doc" ]] || continue
  while IFS= read -r ref; do
    [[ "$ref" == script/* ]] && ref="${ref%% *}"          # `script/check frontend` -> script/check
    [[ "$ref" =~ ^[A-Za-z0-9_.][A-Za-z0-9_./-]*$ && "$ref" == */* ]] || continue
    case "$ref" in origin/*|claude/*|refs/*|*...*) continue ;; esac
    exists "$ref" || fail "$doc names \`$ref\`, which doesn't exist"
  done < <(grep -oE '`[^`]+`' "$doc" | tr -d '`' | sort -u)
done

# 2. Every `paths:` pattern of a rule matches a tracked file. Braces are expanded here
#    (git pathspecs don't know them); globbing is left to git.
for rule in .claude/rules/*.md; do
  while IFS= read -r pattern; do
    [[ -n "$pattern" ]] || continue
    matched=0
    set -f
    # shellcheck disable=SC2086  # brace expansion is the point; the patterns are ours
    for expanded in $(eval "printf '%s\n' $pattern"); do
      [[ -n "$(git ls-files -- ":(glob)$expanded" | head -n1)" ]] && matched=1
    done
    set +f
    (( matched )) || fail "$rule: paths pattern \"$pattern\" matches no file, so the rule never loads for it"
  done < <(awk '/^---$/ { n++; next } n == 1 && /^[[:space:]]*-[[:space:]]*"/ { sub(/^[^"]*"/, ""); sub(/".*$/, ""); print }' "$rule")
done

# 3. CLAUDE.md stays small.
lines="$(wc -l < CLAUDE.md | tr -d ' ')"
(( lines <= 100 )) || fail "CLAUDE.md is $lines lines (limit 100) — move area-specific text into a .claude/rules/ file"

# 4. SPEC.md's "Not built" sections don't describe routes that exist. Only the route
#    tables count (prose there also mentions today's routes). A route counts as built
#    when its last literal segment appears as a word in routes.rb.
while IFS= read -r route; do
  segment="$(tr '/' '\n' <<<"$route" | grep -v '^:' | grep -v '^$' | tail -n1)"
  [[ -n "$segment" ]] || continue
  if grep -Eq "(^|[^a-z_])${segment}([^a-z_]|$)" backend/config/routes.rb; then
    fail "SPEC.md lists \`$route\` under \"Not built\", but routes.rb has \"$segment\" — delete that section of SPEC.md"
  fi
done < <(awk '/^## / { unbuilt = /[Nn]ot built/ } unbuilt && /^\|/' SPEC.md | grep -oE '`/[a-z_/:]+`' | tr -d '`' | sort -u)

# 5. The JSON config parses.
settings=.claude/settings.json
for json in "$settings" .mcp.json; do
  jq empty "$json" 2>/dev/null || fail "$json is not valid JSON"
done

# 6. Hooks and allow rules point at real scripts. The events are the ones in
#    code.claude.com/docs/en/hooks; add a new one here when you first use it.
if jq empty "$settings" 2>/dev/null; then
  events=" PreToolUse PostToolUse PostToolUseFailure PostToolBatch Notification UserPromptSubmit
    UserPromptExpansion SessionStart SessionEnd Stop StopFailure SubagentStart SubagentStop PreCompact
    PostCompact PermissionRequest PermissionDenied Setup TeammateIdle TaskCreated TaskCompleted
    Elicitation ElicitationResult ConfigChange WorktreeCreate WorktreeRemove InstructionsLoaded
    CwdChanged FileChanged "
  while IFS= read -r event; do
    [[ "$events" == *[[:space:]]"$event"[[:space:]]* ]] || fail "$settings: unknown hook event \"$event\""
  done < <(jq -r '.hooks // {} | keys[]' "$settings")

  commands="$(jq -r '.hooks // {} | .[][] | .hooks[]? | .command // empty' "$settings")"
  while IFS= read -r script; do
    [[ -x "$script" ]] || fail "$settings: hook command \"$script\" doesn't exist or isn't executable"
  done < <(grep -oE '"\$CLAUDE_PROJECT_DIR"/[^[:space:]";]+' <<<"$commands" | sed 's|^"\$CLAUDE_PROJECT_DIR"/||' | sort -u)
  for hook in .claude/hooks/*; do
    [[ "$commands" == *"/$hook"* ]] || fail "$hook isn't wired to any event in $settings"
  done

  while IFS= read -r script; do
    [[ -x "$script" ]] || fail "$settings: allow rule names \"$script\", which doesn't exist or isn't executable"
  done < <(jq -r '.permissions.allow // [] | .[]' "$settings" \
    | sed -nE 's/^Bash\(((script|\.claude)\/[^[:space:]:)]+).*/\1/p' | sort -u)
fi

# 7 and 8. Agent and skill frontmatter. Claude Code reads it only when `---` is the first
#    line, and quietly ignores a file or field it can't use.
frontmatter() { # file, field -> the field's value, or nothing
  awk -v key="$2" 'NR == 1 && $0 != "---" { exit } NR > 1 && /^---$/ { exit }
    NR > 1 && index($0, key ":") == 1 { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$1"
}
KEBAB='^[a-z][a-z0-9]*(-[a-z0-9]+)*$'
for agent in .claude/agents/*.md; do
  name="$(frontmatter "$agent" name)"
  [[ -n "$(frontmatter "$agent" description)" ]] || fail "$agent has no description in its frontmatter"
  if [[ -z "$name" ]]; then
    fail "$agent has no name in its frontmatter"
  elif [[ ! "$name" =~ $KEBAB || "$name" != "$(basename "$agent" .md)" ]]; then
    fail "$agent: name \"$name\" should be kebab-case and match the file name"
  fi
done
for skill in .claude/skills/*/SKILL.md; do
  dir="$(basename "$(dirname "$skill")")"
  name="$(frontmatter "$skill" name)"
  [[ -n "$(frontmatter "$skill" description)" ]] || fail "$skill has no description in its frontmatter"
  [[ "$dir" =~ $KEBAB ]] || fail "$skill: directory \"$dir\" should be kebab-case (it is the /command name)"
  [[ -z "$name" || "$name" == "$dir" ]] || fail "$skill: name \"$name\" should match its directory, \"$dir\""
done

if (( errors > 0 )); then
  echo "check-docs: $errors problem(s)" >&2
  exit 1
fi
echo "check-docs: ok (${#docs[@]} files)"
