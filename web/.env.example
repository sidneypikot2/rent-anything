# Copy to web/.env.local (gitignored). Not needed for local development: the API URL is
# derived from the page's port (src/lib/config.ts).

# Production only: the public API origin the browser calls.
NEXT_PUBLIC_API_URL=

# Google and Facebook sign-in buttons (RAA-23); each is hidden while its value is blank.
# The Google client id is the backend's GOOGLE_CLIENT_ID; the Facebook app id its FACEBOOK_APP_ID.
# Both apps need http://localhost:8100 as an authorised JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
