# Copy to backend/.env (gitignored). The app boots with every value blank; each one is
# needed only by the feature named next to it. A new variable here must also be set in the
# staging instance (deploy/staging/backend.env.example) before the PR that needs it merges.

# M1: Google and Facebook sign-in (Auth::Providers). Without them only email/password works.
# GOOGLE_CLIENT_ID is the same OAuth client id the web app uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Partner ID verification (Didit, RAA-44). From the Didit console: the application's API
# key and KYC workflow id, and the webhook destination's secret. Without them partners
# can't verify, and so can't add listings. Use a Didit sandbox application outside production.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Local stack only (RAA-91): true approves every partner's ID check when they next open a
# partner page, without Didit. Ignored outside development; leave it unset on staging.
# Off by default so script/smoke still walks the "verify your ID" gate.
SKIP_ID_CHECK=

# Listing photos on Cloudflare R2 (RAA-106). From the R2 dashboard: the account id, an R2
# API token's access key pair (Object Read & Write on the bucket) and the bucket's name.
# R2_PUBLIC_URL is the bucket's public address (custom domain or r2.dev, no trailing slash);
# guests load photos from it. Every environment, the local stack too, uses this bucket:
# keys start with the environment's folder (staging/ or production/, or development/<stack>/, which
# docker-compose.yml sets as DEV_STORAGE_FOLDER). The bucket's CORS policy must allow PUT
# from each web app origin (staging's and http://localhost:81xx), with the Content-Type and
# Content-MD5 headers. On the local stack these are optional: leave R2_BUCKET blank and
# photos are kept in backend/public/dev-photos instead (PhotoStorage::Disk).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Deferred: phone OTP (Sms::Sender)
SMS_PROVIDER=
SMS_API_KEY=

# M4: Xendit (xenPlatform) payments and payouts
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Bookings (RAA-134): "true" accepts requests the moment they are made; unset, they wait for the
# partner. Staging sets it in deploy/staging/compose.yml.
# BOOKINGS_AUTO_ACCEPT=true

# Payout account numbers (RAA-145) are encrypted by Active Record Encryption. Development and
# test use fixed keys of their own, so leave these blank locally; on staging set each to a long
# random value (`docker compose run --rm backend bin/rails db:encryption:init` prints a set).
# Changing them later makes the saved numbers unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
